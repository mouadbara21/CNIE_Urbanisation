<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P0_tobe" targetNamespace="http://cnie.ma/urbanisation" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="collab_P0_tobe">
    <bpmn:participant id="pool_P0_tobe" name="DGSN - Demande et renouvellement de la CNIE (cible)" processRef="P0_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="P0_tobe" name="Demande et renouvellement de la CNIE - Cible (to-be)" isExecutable="true">
    <bpmn:laneSet id="laneset_P0_tobe">
      <bpmn:lane id="lane_P0_tobe_0" name="Citoyen">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_P0_tobe_1" name="Canal numérique (portail, app)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_P0_tobe_2" name="Plateforme IA">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_P0_tobe_3" name="Agent instructeur">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_P0_tobe_4" name="Agent CEDI">
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_P0_tobe_5" name="Centre de production (CPC)">
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Besoin de CNIE">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="S'authentifier (Identité numérique) ou créer un compte">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t2" name="Pré-remplir la demande (données de la carte / état civil)">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t3" name="[IA] Assistant conversationnel : guider et vérifier la saisie">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t4" name="Compléter la pré-demande et téléverser les pièces">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t5" name="[IA] Contrôle documentaire (OCR, cohérence, photo ICAO)">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Résultat du contrôle ?">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t6" name="Corriger les pièces signalées">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t7" name="Instruire le dossier signalé">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Dossier validé ?">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t8" name="Payer les frais en ligne (e-timbre intégré)">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t9" name="[IA] Recommander les créneaux (prévision d'affluence)">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t10" name="Confirmer le créneau au CEDI">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t11" name="Émettre la convocation QR + rappels automatiques">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t12" name="Scanner le QR et capturer la biométrie">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="t13" name="[IA] Vérifier la biométrie (dédoublonnage, anti-fraude)">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g3" name="Alerte fraude ?">
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t14" name="Traiter l'alerte (enquête)">
      <bpmn:incoming>flow_21</bpmn:incoming>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t15" name="Contrôler, personnaliser et expédier (suivi temps réel)">
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:outgoing>flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t16" name="Notifier « Disponible » (push, SMS, e-mail)">
      <bpmn:incoming>flow_24</bpmn:incoming>
      <bpmn:outgoing>flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g4" name="Mode de remise ?">
      <bpmn:incoming>flow_25</bpmn:incoming>
      <bpmn:outgoing>flow_26</bpmn:outgoing>
      <bpmn:outgoing>flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t17" name="Remettre la carte au CEDI (PIN sécurisé)">
      <bpmn:incoming>flow_26</bpmn:incoming>
      <bpmn:outgoing>flow_28</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="t18" name="Livrer par la Poste avec authentification à la remise">
      <bpmn:incoming>flow_27</bpmn:incoming>
      <bpmn:outgoing>flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t19" name="Activer la carte numérique dans Mon e-ID">
      <bpmn:incoming>flow_28</bpmn:incoming>
      <bpmn:incoming>flow_29</bpmn:incoming>
      <bpmn:outgoing>flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Carte remise et identité numérique active">
      <bpmn:incoming>flow_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Demande rejetée">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:incoming>flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="t1" targetRef="t2" />
