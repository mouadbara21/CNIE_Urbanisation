<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P0_asis" targetNamespace="http://cnie.ma/urbanisation" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="collab_P0_asis">
    <bpmn:participant id="pool_P0_asis" name="DGSN - Demande et renouvellement de la CNIE (actuel)" processRef="P0_asis" />
  </bpmn:collaboration>
  <bpmn:process id="P0_asis" name="Demande et renouvellement de la CNIE - Actuel (as-is)" isExecutable="true">
    <bpmn:laneSet id="laneset_P0_asis">
      <bpmn:lane id="lane_P0_asis_0" name="Citoyen">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_P0_asis_1" name="Portail cnie.ma">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t19</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_P0_asis_2" name="Agent CEDI">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_P0_asis_3" name="Centre de production (CPC)">
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Besoin de CNIE (1re demande, renouvellement, duplicata)">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="t1" name="Rassembler les pièces (acte, certificat de résidence, 4 photos)">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t2" name="Acheter l'e-timbre (75 DH)">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t3" name="Saisir la pré-demande (identité, filiation, adresse, AR/FR)">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t4" name="Générer le numéro de pré-demande">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t5" name="Choisir le CEDI, la date et le créneau">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Créneau disponible ?">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t6" name="Émettre le récépissé de rendez-vous">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t7" name="Imprimer et signer le formulaire">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t8" name="Se présenter au CEDI avec le dossier">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t9" name="Contrôler l'identité et les pièces">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g2" name="Dossier complet ?">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t10" name="Statut « Dossier incomplet »">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t11" name="Capturer la biométrie (photo, empreintes, signature)">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t12" name="Valider le dossier et remettre le récépissé daté">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="t13" name="Contrôler l'unicité (AFIS) et la qualité">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t14" name="Personnaliser la carte (puce, Lasink)">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t15" name="Expédier la carte au CEDI">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="t16" name="Statut « Disponible » + e-mail/SMS">
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t17" name="Se présenter au CEDI avec le récépissé">
      <bpmn:incoming>flow_21</bpmn:incoming>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t18" name="Remettre la carte et le code PIN">
      <bpmn:incoming>flow_22</bpmn:incoming>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="t19" name="Statut « Remise »">
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:outgoing>flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Carte remise">
      <bpmn:incoming>flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="t5" targetRef="g1" />
    <bpmn:sequenceFlow id="flow_7" name="non : autre centre / autre date" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="flow_8" name="oui" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="t9" targetRef="g2" />
    <bpmn:sequenceFlow id="flow_13" name="non" sourceRef="g2" targetRef="t10" />
    <bpmn:sequenceFlow id="flow_14" name="nouveau RDV" sourceRef="t10" targetRef="t5" />
    <bpmn:sequenceFlow id="flow_15" name="oui" sourceRef="g2" targetRef="t11" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="t12" targetRef="t13" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="t13" targetRef="t14" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="t14" targetRef="t15" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="t15" targetRef="t16" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="t16" targetRef="t17" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="t17" targetRef="t18" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="t18" targetRef="t19" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="t19" targetRef="e1" />
  </bpmn:process>
