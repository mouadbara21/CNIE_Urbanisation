    </element>
    <element xsi:type="archimate:Goal" name="G5 - Pilotage par la donnée et l'IA" id="el-0018">
    </element>
    <element xsi:type="archimate:Outcome" name="Dossiers incomplets au CEDI &lt; 5 %" id="el-0019">
    </element>
    <element xsi:type="archimate:Outcome" name="Temps moyen en centre &lt; 15 min" id="el-0020">
    </element>
    <element xsi:type="archimate:Outcome" name="Taux d'activation Mon e-ID &gt; 80 %" id="el-0021">
    </element>
    <element xsi:type="archimate:Principle" name="Dites-le nous une fois" id="el-0022">
    </element>
    <element xsi:type="archimate:Principle" name="Protection des données dès la conception (CNDP)" id="el-0023">
